# Zoom Server-to-Server OAuth credentials
# Get these from https://marketplace.zoom.us/ → your Server-to-Server OAuth app
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# MCP server settings (optional, defaults shown)
ZOOM_PHONE_MCP_HOST=0.0.0.0
ZOOM_PHONE_MCP_PORT=8767

# Optional: restrict write operations
# ZOOM_PHONE_MCP_READ_ONLY=false
